# Backend Environment Configuration Example
# Copy this file to .env and adjust the values (machine-specific overrides go in .env.local)

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your-app-secret-here-change-this
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL 8.0; these values match the defaults of compose.yaml
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/cms_db?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your-jwt-passphrase-here
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
# The messenger_messages table is created by the migrations
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
