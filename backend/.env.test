# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Functional tests run on a throwaway SQLite file, no MySQL server needed
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Not defined in .env.example but required by config/packages
MESSENGER_TRANSPORT_DSN=in-memory://
MAILER_DSN=null://null

# Unencrypted RSA key pair generated by tests/bootstrap.php
JWT_SECRET_KEY=%kernel.project_dir%/var/jwt-test/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/var/jwt-test/public.pem
JWT_PASSPHRASE=
